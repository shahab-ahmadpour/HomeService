@model App.Domain.Core.DTO.Users.Experts.ExpertDto
@{
    ViewData["Title"] = "نظرات مشتریان";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var reviews = ViewBag.Reviews as List<App.Domain.Core.DTO.Reviews.ReviewDto> ?? new List<App.Domain.Core.DTO.Reviews.ReviewDto>();
    var averageRating = ViewBag.AverageRating ?? 0.0;
}

<div class="container py-4">
    <!-- بخش نمایش پیام‌ها -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="bi bi-chat-square-text me-2"></i>
                        نظرات تایید شده مشتریان
                    </h3>
                    <a href="@Url.Action("Dashboard", "Expert")" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-right me-1"></i> بازگشت به داشبورد
                    </a>
                </div>
                <div class="card-body">
                    @if (reviews.Any())
                    {
                        <div class="row mb-4">
                            <div class="col-md-4 text-center">
                                <div class="p-4 rounded bg-light">
                                    <h1 class="display-4 text-primary">@averageRating.ToString("0.0")</h1>
                                    <div class="mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(averageRating))
                                            {
                                                <i class="bi bi-star-fill text-warning fs-4"></i>
                                            }
                                            else if (i - 0.5 <= averageRating)
                                            {
                                                <i class="bi bi-star-half text-warning fs-4"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning fs-4"></i>
                                            }
                                        }
                                    </div>
                                    <p class="text-muted">از مجموع @reviews.Count نظر</p>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="px-4">
                                    @for (int i = 5; i >= 1; i--)
                                    {
                                        var count = reviews.Count(r => r.Rating == i);
                                        var percentage = reviews.Count > 0 ? (count * 100.0 / reviews.Count) : 0;
                                        <div class="d-flex align-items-center mb-3">
                                            <div style="width: 50px" class="fw-bold">@i <i class="bi bi-star-fill text-warning"></i></div>
                                            <div class="progress flex-grow-1 mx-2" style="height: 10px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @percentage%"
                                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <div style="width: 70px" class="text-end">@count نظر (@percentage.ToString("0")%)</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- فیلتر و جستجو -->
                        <div class="mb-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <input type="text" id="searchReviews" class="form-control" placeholder="جستجو در نظرات...">
                                        <button class="btn btn-outline-secondary" type="button">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <select id="filterRating" class="form-select">
                                        <option value="0">همه نظرات</option>
                                        <option value="5">5 ستاره</option>
                                        <option value="4">4 ستاره</option>
                                        <option value="3">3 ستاره</option>
                                        <option value="2">2 ستاره</option>
                                        <option value="1">1 ستاره</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- لیست نظرات -->
                        <div class="reviews-list">
                            @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="review-item p-3 mb-3 border rounded shadow-sm" data-rating="@review.Rating">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <span class="fw-bold fs-5">@review.CustomerName</span>
                                            <span class="text-muted ms-2">@review.CreatedAt.ToString("yyyy/MM/dd")</span>
                                        </div>
                                        <div>
                                            <span class="badge bg-primary rounded-pill me-2">@review.Rating</span>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-secondary"></i>
                                                }
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(review.OrderDescription))
                                    {
                                        <div class="bg-light p-2 rounded mb-3">
                                            <i class="bi bi-tools me-1"></i>
                                            <span class="text-muted">خدمت: </span>
                                            <span class="fw-bold">@review.OrderDescription</span>
                                        </div>
                                    }

                                    <div class="review-content">
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <p class="mb-0">@review.Comment</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted fst-italic mb-0">نظری ثبت نشده است</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-chat-square-text text-muted" style="font-size: 5rem;"></i>
                            <h4 class="mt-3 text-muted">هنوز نظر تایید شده‌ای برای شما ثبت نشده است</h4>
                            <p>پس از انجام موفقیت‌آمیز سفارش‌های شما، مشتریان می‌توانند نظرات خود را ثبت کنند که پس از تایید نمایش داده می‌شوند.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // فیلتر کردن نظرات بر اساس امتیاز
            $("#filterRating").change(function () {
                var rating = $(this).val();

                if (rating === "0") {
                    // نمایش همه نظرات
                    $(".review-item").show();
                } else {
                    // فیلتر کردن بر اساس امتیاز
                    $(".review-item").hide();
                    $(".review-item[data-rating='" + rating + "']").show();
                }
            });

            // جستجو در نظرات
            $("#searchReviews").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $(".review-item").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        .progress {
            border-radius: 20px;
            background-color: #e9ecef;
        }

        .progress-bar {
            border-radius: 20px;
        }

        .review-item {
            transition: transform 0.2s ease;
        }

            .review-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 12px rgba(0,0,0,0.1) !important;
            }
    </style>
}