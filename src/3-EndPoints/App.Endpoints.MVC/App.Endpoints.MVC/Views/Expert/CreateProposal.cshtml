@model App.Domain.Core.DTO.Proposals.CreateProposalDto
@using App.Domain.Core.Enums
@using App.Endpoints.MVC.Extensions

@{
    ViewData["Title"] = "ارائه پیشنهاد";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var request = ViewBag.Request as App.Domain.Core.DTO.Requests.RequestDto;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">ارائه پیشنهاد برای درخواست #@request.Id</h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="bg-light p-3 rounded">
                            <h5 class="border-bottom pb-2 mb-3">جزئیات درخواست</h5>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <p><strong>نوع سرویس:</strong> @request.SubHomeServiceName</p>
                                    <p><strong>تاریخ اجرا:</strong> @request.ExecutionDate.ToPersianDate()</p>
                                    <p><strong>مشتری:</strong> @ViewBag.CustomerName</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>وضعیت:</strong> @request.Status.GetDisplayName()</p>
                                    <p><strong>تاریخ ثبت:</strong> @request.CreatedAt.ToPersianDate()</p>
                                </div>
                            </div>
                            <div>
                                <p><strong>توضیحات درخواست:</strong></p>
                                <p class="text-secondary">@(string.IsNullOrEmpty(request.Description) ? "بدون توضیحات" : request.Description)</p>
                            </div>
                        </div>
                    </div>

                    <form method="post" asp-action="CreateProposal">
                        <input type="hidden" asp-for="RequestId" />
                        <input type="hidden" asp-for="ExpertId" />

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">مبلغ پیشنهادی (تومان)</label>
                            <input type="number" class="form-control" asp-for="Price" min="0" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExecutionDate" class="form-label fw-bold">تاریخ اجرا</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <input type="text" id="persianDatePicker" class="form-control" placeholder="انتخاب تاریخ" />
                                <input type="hidden" asp-for="ExecutionDate" id="hiddenExecutionDate" />
                            </div>
                            <span asp-validation-for="ExecutionDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">توضیحات پیشنهاد</label>
                            <textarea class="form-control" asp-for="Description" rows="5" placeholder="توضیحات خود را وارد کنید..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="AvailableRequests" class="btn btn-secondary">
                                <i class="bi bi-arrow-right me-1"></i> بازگشت
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> ثبت پیشنهاد
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // تنظیم تاریخ شمسی
        $("#persianDatePicker").pDatepicker({
            format: 'YYYY/MM/DD',
            autoClose: true,
            initialValue: true,
            onSelect: function(unix) {
                // تبدیل به تاریخ میلادی برای ارسال به سرور
                const pDate = new persianDate(unix);
                const gDate = pDate.toCalendar('gregorian').toLocale('en').format('YYYY-MM-DD');
                $("#hiddenExecutionDate").val(gDate);
            }
        });

        // تنظیم تاریخ اولیه
        $(document).ready(function() {
            // تنظیم تاریخ اجرا با مقدار از مدل
            const executionDate = '@Model.ExecutionDate.ToString("yyyy-MM-dd")';
            if (executionDate) {
                const date = new Date(executionDate);
                const pDate = new persianDate(date);
                $("#persianDatePicker").val(pDate.format('YYYY/MM/DD'));
                $("#hiddenExecutionDate").val(executionDate);
            }
        });
    </script>
}