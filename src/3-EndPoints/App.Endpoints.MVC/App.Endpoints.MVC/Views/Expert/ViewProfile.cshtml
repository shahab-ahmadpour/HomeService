@model App.Domain.Core.DTO.Users.Experts.ExpertDto
@{
    ViewData["Title"] = "پروفایل کارشناس";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    var skills = ViewBag.ExpertSkills as List<App.Domain.Core.DTO.Skills.SkillDto> ?? new List<App.Domain.Core.DTO.Skills.SkillDto>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">پروفایل کارشناس</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-4 text-center">
                            <div class="mb-4">
                                <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/images/default-avatar.png" : Model.ProfilePicture)"
                                     class="img-fluid rounded-circle" style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #1e3a8a;"
                                     alt="تصویر پروفایل">
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h4 class="mb-3">@Model.FirstName @Model.LastName</h4>
                            <p><i class="bi bi-geo-alt-fill text-primary"></i> @(string.IsNullOrEmpty(Model.City) ? "شهر ثبت نشده" : $"{Model.City}، {Model.State}")</p>
                            <p><i class="bi bi-telephone-fill text-primary"></i> @Model.PhoneNumber</p>

                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <p><i class="bi bi-house-door-fill text-primary"></i> @Model.Address</p>
                            }

                            <div class="mt-3">
                                <h5 class="border-bottom pb-2 mb-3">مهارت‌ها</h5>
                                <div class="d-flex flex-wrap">
                                    @if (skills.Any())
                                    {
                                        foreach (var skill in skills)
                                        {
                                            <span class="badge bg-primary me-2 mb-2 p-2">@skill.Name</span>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted">هیچ مهارتی ثبت نشده است.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-4">
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="bi bi-arrow-right me-1"></i> بازگشت
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>