@model App.Domain.Core.DTO.Transactions.PaymentViewModel

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "پرداخت سفارش";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 text-center">پرداخت سفارش</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light">
                                <h5 class="mb-3">اطلاعات حساب</h5>
                                <p class="mb-2"><strong>موجودی فعلی:</strong> <span class="text-success">@Model.CurrentBalance.ToString("N0") تومان</span></p>
                                <p class="mb-2"><strong>مبلغ قابل پرداخت:</strong> <span class="text-danger">@Model.AmountToPay.ToString("N0") تومان</span></p>
                                <p class="mb-2"><strong>کارشناس:</strong> @Model.ExpertName</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <h5 class="mb-3">پرداخت</h5>
                                <p class="small text-muted mb-3">
                                    با کلیک روی دکمه پرداخت، مبلغ مورد نظر از حساب شما کسر و سفارش شما پردازش خواهد شد.
                                </p>

                                <form asp-action="ProcessPayment" method="post">
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="bi bi-credit-card me-2"></i>پرداخت
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-3">
                        @if (Model.ReturnToMyOrders)
                        {
                            <a href="@Url.Action("MyOrders")" class="btn btn-secondary">
                                <i class="bi bi-arrow-right me-1"></i> بازگشت به سفارش‌های من
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Orders")" class="btn btn-secondary">
                                <i class="bi bi-arrow-right me-1"></i> بازگشت به لیست سفارش‌ها
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        background-color: #1e3a8a !important;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }
</style>