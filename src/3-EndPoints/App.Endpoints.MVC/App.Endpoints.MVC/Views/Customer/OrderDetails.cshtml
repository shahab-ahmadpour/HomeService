@model App.Domain.Core.DTO.Orders.OrderDto
@using App.Domain.Core.Enums
@using App.Endpoints.MVC.Extensions

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "جزئیات سفارش";
    var returnToMyOrders = ViewBag.ReturnToMyOrders ?? false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 text-center">جزئیات سفارش</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model == null)
                    {
                        <div class="text-center py-5">
                            <div class="alert alert-warning">سفارش یافت نشد.</div>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2 mb-3 text-primary">اطلاعات سفارش</h5>
                                <p><strong>شماره سفارش:</strong> @Model.Id</p>
                                <p><strong>تاریخ سفارش:</strong> @Model.CreatedAt.ToPersianDate()</p>
                                <p><strong>وضعیت پرداخت:</strong> <span class="badge @GetPaymentStatusBadgeClass(Model.PaymentStatus)">@Model.PaymentStatus.GetDisplayName()</span></p>
                                <p><strong>قیمت نهایی:</strong> @Model.FinalPrice.ToString("N0") تومان</p>
                            </div>
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2 mb-3 text-primary">جزئیات سرویس</h5>
                                <p><strong>سرویس:</strong> @Model.SubHomeServiceName</p>
                                <p><strong>کارشناس:</strong> @Model.ExpertName</p>
                                @if (Model.Proposals != null && Model.Proposals.Any())
                                {
                                    var proposal = Model.Proposals.First();
                                    <p><strong>تاریخ اجرا:</strong> @proposal.ExecutionDate.ToPersianDate()</p>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3 text-primary">توضیحات</h5>
                            <div class="p-3 bg-light rounded">
                                <p><strong>توضیحات درخواست:</strong></p>
                                <p>@(string.IsNullOrEmpty(Model.RequestDescription) ? "بدون توضیحات" : Model.RequestDescription)</p>

                                @if (Model.Proposals != null && Model.Proposals.Any())
                                {
                                    var proposal = Model.Proposals.First();
                                    <p class="mt-3"><strong>توضیحات پیشنهاد:</strong></p>
                                    <p>@(string.IsNullOrEmpty(proposal.Description) ? "بدون توضیحات" : proposal.Description)</p>
                                }
                            </div>
                        </div>

                        @if (Model.PaymentStatus == PaymentStatus.Pending)
                        {
                            <div class="text-center mb-4">
                                <a href="@Url.Action("Payment", new { orderId = Model.Id, returnToMyOrders = returnToMyOrders })" class="btn btn-success px-4">
                                    <i class="bi bi-credit-card me-1"></i> پرداخت
                                </a>
                            </div>
                        }

                        <div class="text-center">
                            @if (returnToMyOrders)
                            {
                                <a href="@Url.Action("MyOrders")" class="btn btn-secondary px-4">
                                    <i class="bi bi-arrow-right me-1"></i> بازگشت به سفارش‌های من
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Orders")" class="btn btn-secondary px-4">
                                    <i class="bi bi-arrow-right me-1"></i> بازگشت به لیست سفارش‌ها
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetPaymentStatusBadgeClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "bg-warning",
            PaymentStatus.paid => "bg-success",
            PaymentStatus.Completed => "bg-primary",
            PaymentStatus.Failed => "bg-danger",
            _ => "bg-secondary"
        };
    }
}